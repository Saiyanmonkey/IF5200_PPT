# PostgreSQL (Transactional Data & pg_trgm)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# DB_MODE controls DB routing:
# - auto: prefer DATABASE_URL, then SUPABASE_DATABASE_URL, then local POSTGRES_* fallback
# - supabase: force Supabase URL (SUPABASE_DATABASE_URL or DATABASE_URL)
# - local: force local POSTGRES_* URL
DB_MODE=auto

# Optional explicit DB URLs
DATABASE_URL=
SUPABASE_DATABASE_URL=

# Supabase Auth verification
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Supabase Storage (CV uploads for referrals)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=referral-cv

# Fonnte WhatsApp API (free tier works with the same send endpoint)
FONNTE_API_KEY=
FONNTE_SENDER=

# Neo4j (Graph Data)
NEO4J_USERNAME=
NEO4J_PASSWORD=
NEO4J_URI=
NEO4J_DATABASE=
AURA_INSTANCEID=
AURA_INSTANCENAME=

# Redis (Ghost Hashes & Rate Limiting)
REDIS_URL=

# Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=
